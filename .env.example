# =============================================================================
# TransitX — Environment Variables
# Copy this file to .env and fill in production values.
# =============================================================================

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=transitx_db
DB_USER=transitx
DB_PASSWORD=change_me_in_production

# Authentication
JWT_SECRET=change_me_to_a_random_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Backend
BACKEND_PORT=8080

# Frontend URLs (used by backend for CORS / redirects)
FRONTEND_URL=http://localhost:5173
DRIVER_APP_URL=http://localhost:5174
